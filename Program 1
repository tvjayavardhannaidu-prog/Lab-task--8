#include <iostream>
using namespace std;

struct Node {
    char ch;
    int freq;
    Node *left, *right;
};

Node* createNode(char ch, int freq) {
    Node* node = new Node;
    node->ch = ch;
    node->freq = freq;
    node->left = nullptr;
    node->right = nullptr;
    return node;
}

void sortNodes(Node* arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j]->freq > arr[j + 1]->freq) {
                Node* temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

Node* buildHuffman(char ch[], int freq[], int n) {
    Node* arr[100];

    for (int i = 0; i < n; i++) {
        arr[i] = createNode(ch[i], freq[i]);
    }

    int size = n;

    while (size > 1) {
        sortNodes(arr, size);

        Node* left = arr[0];
        Node* right = arr[1];

        Node* parent = createNode(
            '$', left->freq + right->freq
        );

        parent->left = left;
        parent->right = right;

        arr[0] = parent;
        arr[1] = arr[size - 1];
        size--;
    }

    return arr[0];
}

void printCodes(Node* root, int code[], int top) {
    if (root == nullptr) {
        return;
    }

    if (root->left != nullptr) {
        code[top] = 0;
        printCodes(root->left, code, top + 1);
    }

    if (root->right != nullptr) {
        code[top] = 1;
        printCodes(root->right, code, top + 1);
    }

    if (root->left == nullptr &&
        root->right == nullptr) {

        cout << root->ch << " : ";

        for (int i = 0; i < top; i++) {
            cout << code[i];
        }

        cout << endl;
    }
}

void deleteTree(Node* root) {
    if (root == nullptr) {
        return;
    }

    deleteTree(root->left);
    deleteTree(root->right);
    delete root;
}

int main() {
    char ch[] = {
        'a', 'c', 'd', 'e', 'o',
        'm', 's', 't', 'u'
    };

    int freq[] = {20, 11, 2, 10, 15, 8, 10, 22, 2};
    int n = 9;
    int code[100];

    Node* root = buildHuffman(ch, freq, n);

    cout << "Huffman Codes:\n";
    printCodes(root, code, 0);

    deleteTree(root);

    return 0;
}
